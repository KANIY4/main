# CleanQuote AI — environment template.
#
# Copy to `.env.local` and fill in what you have. Everything here is optional:
# with none of it set, the web app runs in demonstration mode, pricing the seed
# cases with the real engine. Nothing is silently faked — the UI states which
# mode it is in.
#
# Never commit a filled-in copy of this file.

# --- Branding -------------------------------------------------------------
# The product name is configuration. Change it here, not in the source.
NEXT_PUBLIC_APP_NAME="CleanQuote AI"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Database (Supabase) --------------------------------------------------
# Without these the app serves the demonstration cases from local fixtures.
# Activation:
#   1. Create a Supabase project.
#   2. Apply supabase/migrations in filename order.
#   3. Paste the project URL and anon key below.
# The anon key is publishable by design — it is useless without the row level
# security policies behind it. See docs/SECURITY.md.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Bypasses row level security. Server-side only, never in a client bundle, and
# never in a browser-visible variable. Used only by trusted server functions
# (billing webhooks, scheduled jobs, audit writes).
SUPABASE_SERVICE_ROLE_KEY=

# --- AI -------------------------------------------------------------------
# `mock` returns fixture extractions so the copilot flow can be developed and
# tested without spending anything or needing an account.
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
AI_MODEL_FAST=claude-haiku-4-5-20251001
AI_MODEL_CAPABLE=claude-opus-5
# Hard monthly ceiling per organisation, in the billing currency. Requests are
# refused rather than queued once an organisation crosses it.
AI_MONTHLY_BUDGET_PER_ORG=50

# --- Billing (Stripe) -----------------------------------------------------
# Entitlements are enforced server-side from the database. Stripe is the source
# of truth for subscription state only; a webhook never takes an entitlement
# claim from the client.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Observability --------------------------------------------------------
SENTRY_DSN=

# --- Media storage --------------------------------------------------------
# Unset, captured photos are written under STORAGE_LOCAL_ROOT and served through
# signed, expiring links. That is a working mode, not a stub: uploads,
# thumbnails, expiry and deletion all behave as they do in production.
#
# Activation (any S3-compatible endpoint, Supabase Storage included):
#   1. Create a PRIVATE bucket.
#   2. Add a storage policy restricting objects to the caller's organisation
#      prefix. The application does not rely on it alone — see docs/STORAGE.md.
#   3. Set the five variables below.
STORAGE_PROVIDER="local"
STORAGE_LOCAL_ROOT=".storage"
STORAGE_BUCKET="capture"
STORAGE_ENDPOINT=
STORAGE_REGION="auto"
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# How long a media link stays valid. These are site photos, so it is short.
STORAGE_SIGNED_URL_TTL_SECONDS="600"

# Signs local media links. Generated per process when unset, which is correct
# for one node and wrong across replicas. Set it if you run more than one.
STORAGE_URL_SIGNING_SECRET=

# --- Cookies --------------------------------------------------------------
# Session cookies are Secure by default. Set this to "false" only to run the
# application over a plain-HTTP origin, which is a local-development choice —
# a Secure cookie is not sent to an http:// origin, so sign-in silently fails
# without it.
COOKIE_SECURE=

# --- Production coherence -------------------------------------------------
# A production build refuses to serve the signed-in application when it is
# configured with the local storage or email adapters, because both fail
# silently and confusingly in front of real users: photos vanish, and nobody
# can confirm an email address. Set this to "true" to run a production build
# against the local adapters anyway — sensible only on a single machine you
# control, which is what the end-to-end smoke run does.
ALLOW_LOCAL_ADAPTERS_IN_PRODUCTION=

# Serverless deployments should point DATABASE_URL at a pooled endpoint and
# keep this small; each instance opens its own pool.
DATABASE_POOL_MAX=
