# Copy to .env.local for development. Never commit a populated file.
# Values are validated by packages/config/src/env.ts at build and at runtime.

APP_ENV=local
NODE_ENV=development

# Database and storage — provider confirmed by decision D-02
DATABASE_URL=postgres://postgres:postgres@localhost:5432/brandwoop
DATABASE_SERVICE_KEY=replace-me-server-only
STORAGE_BUCKET_EVIDENCE=brandwoop-evidence-local
STORAGE_BUCKET_REPORTS=brandwoop-reports-local

# Transactional email — sender domain confirmed by decision D-08
EMAIL_API_KEY=replace-me
EMAIL_SENDER_ADDRESS=reports@example.test

# Minimum 32 characters. Rotated per environment.
CRON_SHARED_SECRET=replace-me-with-a-32-character-secret

SESSION_COOKIE_DOMAIN=localhost
RELEASE_VERSION=0.0.0-dev

# Public values — safe to expose to the browser bundle
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_VERSION=v1
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.test

# Mobile
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
EXPO_PUBLIC_APP_ENV=development
